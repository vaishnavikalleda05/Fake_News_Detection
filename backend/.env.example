# Fake News Detection Configuration Template
PROJECT_NAME="Fake News Detection API"
VERSION="1.0.0"
API_PREFIX="/api"

# Model path (relative to project root or absolute)
MODEL_PATH=outputs/pipeline.joblib

# Allowed CORS origins for frontend integration (comma-separated or list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Server settings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Optional Fact-Check & Web Search Provider API Keys
GOOGLE_FACTCHECK_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
BING_SEARCH_API_KEY=

# Evidence & Claim Extraction Limits
EVIDENCE_TIMEOUT_SECONDS=5.0
MAX_CLAIMS_PER_ANALYSIS=5
MAX_EVIDENCE_PER_CLAIM=5